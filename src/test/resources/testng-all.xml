<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Full run - EVERY test, including the ones that spend real credits.

  Approx cost: ~155 credits
    CreditUsageTest    Document 3 + Image 12   =  15
    AiGenerationTest   Chat 0 + Image 12 + Doc 3 = 15
    VideoProcessingTest TC_DEF_007b            = 125

  Run with:
    mvn test -Dsurefire.suiteXmlFiles=src/test/resources/testng-all.xml

  Ordering is deliberate and preserve-order keeps it. Sign-in is server-throttled
  ("Too many requests"), and LoginTest authenticates on almost every method while
  its sign-out tests revoke the shared token. Running it anywhere but last starves
  every SingleSessionTest class that follows, which then fails on the throttle
  rather than on what it asserts. Classes that need a session go first and keep it;
  the ones that need no session at all go first of all.
-->
<suite name="Self-Healing Locator Engine Full Suite" verbose="2" parallel="false" preserve-order="true">

    <listeners>
        <listener class-name="com.portfolio.selfhealing.listeners.AllureListener"/>
        <listener class-name="com.portfolio.selfhealing.listeners.RetryListener"/>
    </listeners>

    <test name="All Tests" enabled="true">
        <classes>
            <!-- Self-healing engine: offline fixtures, no server at all. -->
            <class name="com.portfolio.selfhealing.healing.core.SimilarityScorerTest"/>
            <class name="com.portfolio.selfhealing.healing.core.SafetyGuardTest"/>
            <class name="com.portfolio.selfhealing.healing.core.SelectorHintsTest"/>
            <class name="com.portfolio.selfhealing.healing.core.JsonHealingStoreTest"/>
            <class name="com.portfolio.selfhealing.healing.core.HealingEngineTest"/>
            <class name="com.portfolio.selfhealing.healing.SelfHealingFixtureTest"/>

            <!-- No session required: cannot be affected by the sign-in throttle. -->
            <class name="com.portfolio.selfhealing.tests.NoTokenTest"/>
            <class name="com.portfolio.selfhealing.tests.HelpCenterTest"/>

            <!-- Share one saved session between them. -->
            <class name="com.portfolio.selfhealing.tests.DashboardTest"/>
            <class name="com.portfolio.selfhealing.tests.AiToolsTest"/>
            <class name="com.portfolio.selfhealing.tests.HistoryTest"/>
            <class name="com.portfolio.selfhealing.tests.RegenerateTest"/>

            <!-- Spend credits. Still session-based, so they stay ahead of LoginTest. -->
            <class name="com.portfolio.selfhealing.tests.VideoProcessingTest"/>
            <class name="com.portfolio.selfhealing.tests.CreditUsageTest"/>
            <class name="com.portfolio.selfhealing.tests.AiGenerationTest"/>

            <!-- Last: signs in repeatedly and signs out, invalidating the session. -->
            <class name="com.portfolio.selfhealing.tests.LoginTest"/>
        </classes>
    </test>

</suite>
